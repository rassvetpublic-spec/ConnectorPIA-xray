      "layout": "BOARD_LAYOUT",
      "filter": "is:open {status}:\"В работе\""
    },
    {
      "name": "03 — QA Gate",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open {status}:\"Проверка QA\""
    },
    {
      "name": "04 — Release Flow",
      "layout": "BOARD_LAYOUT",
      "filter": "is:pr"
    },
    {
      "name": "05 — Roadmap",
      "layout": "ROADMAP_LAYOUT",
      "filter": "is:open"
    },
    {
      "name": "06 — Blocked / Parking",
      "layout": "TABLE_LAYOUT",
      "filter": "is:open {status}:\"Заблокировано\""
